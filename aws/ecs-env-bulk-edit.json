{
  "_meta": {
    "description": "Bulk-edit JSON for ECS task definition environment variables and secrets. For each service, paste the 'environment' array into the ECS Console → Task Definition → Container → Environment variables (Bulk edit JSON) and the 'secrets' array into the Secrets section.",
    "secrets_manager_setup": {
      "secret_name": "food-delivery/config",
      "keys": ["JWT_SECRET", "GOOGLE_AI_API_KEY", "TWILIO_ACCOUNT_SID", "TWILIO_AUTH_TOKEN", "TWILIO_WHATSAPP_FROM", "DB_PASSWORD"]
    },
    "iam_task_roles": {
      "sns-sqs-services": {
        "services": ["customer-service", "restaurant-service", "order-service", "delivery-service", "notification-service"],
        "required_permissions": ["sns:Publish", "sqs:SendMessage", "sqs:ReceiveMessage", "sqs:DeleteMessage", "sqs:GetQueueAttributes"]
      },
      "chat-service": {
        "required_permissions": ["bedrock:InvokeModel"],
        "note": "Attach a task role with bedrock:InvokeModel — no AWS_ACCESS_KEY_ID or AWS_SECRET_ACCESS_KEY needed when using IAM task roles"
      }
    }
  },

  "discovery-server": {
    "environment": [
      { "name": "SPRING_PROFILES_ACTIVE", "value": "aws" },
      { "name": "AWS_REGION", "value": "eu-central-1" },
      { "name": "EUREKA_HOSTNAME", "value": "discovery-server.food-delivery.local" }
    ],
    "secrets": []
  },

